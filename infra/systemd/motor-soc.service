[Unit]
Description=Motor de Decisiones SOC — Tesis UBO
After=network.target redis-server.service
Requires=redis-server.service

[Service]
Type=simple
User=aiayala
WorkingDirectory=/home/aiayala/tesis/motor
Environment=REDIS_HOST=localhost
ExecStart=/home/aiayala/.local/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
