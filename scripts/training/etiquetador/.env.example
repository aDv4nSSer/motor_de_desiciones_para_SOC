# Copiar a .env en el mismo directorio del script en .139 (/home/aiayala/tesis/ataques/.env)
# chmod 600, nunca commitear el .env real. El cron hace ". .env &&" antes de invocar
# python3, así que la variable necesita "export" para propagar al proceso hijo.
export ABUSEIPDB_KEY=your_abuseipdb_key_here
