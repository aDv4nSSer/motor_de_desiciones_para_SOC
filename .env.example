# ============================================================
# Motor de Decisiones para SOC — Variables de entorno
# Copiar a .env y completar con valores reales.
# NUNCA commitear .env con valores reales.
# ============================================================

# --- OpenSearch (leído por motor/opensearch_indexer.py, motor/dashboard.py,
# vigilante/shadow_detect.py — nombres deben coincidir exactamente, el código
# lee OS_HOST/OS_USER/OS_PASS, no OPENSEARCH_*) ---
# OS_HOST es la URL base completa (esquema + host + puerto), ej. https://localhost:9201
OS_HOST=https://localhost:9201
OS_USER=admin
OS_PASS=change_me

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=soc_db
POSTGRES_USER=soc_user
POSTGRES_PASSWORD=change_me

# --- Suricata ---
SURICATA_EVE_PATH=/var/log/suricata/eve.json

# --- Vector ---
VECTOR_DATA_DIR=./pipeline-ingesta/.vector-data
VECTOR_OUTPUT_DIR=./pipeline-ingesta/outputs

# --- FastAPI ---
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_SECRET_KEY=change_me_use_openssl_rand_hex_32
FASTAPI_DEBUG=false

# --- Wazuh ---
WAZUH_HOST=localhost
WAZUH_PORT=55000
WAZUH_USER=wazuh
WAZUH_PASSWORD=change_me

# --- Modelo ML ---
ML_MODEL_PATH=./models/classifier.pkl
ML_SCALER_PATH=./models/scaler.pkl
ML_ENCODER_PATH=./models/encoder.pkl
ML_MODEL_VERSION=v1.0.0

# --- API ---
API_TITLE=Motor de Decisiones SOC
API_VERSION=0.1.0
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

# --- R1: Threat Intelligence (motor/response) ---
ABUSEIPDB_API_KEY=
OTX_API_KEY=
