# --- Secretos y configuración local ---
.env
.env.local
.env.*.local
.secrets
# .secrets.baseline es config de detect-secrets y debe commitearse

# --- Modelos ML ---
*.pkl
*.joblib
models/
# H26: en .140, motor/models es un symlink hacia motor-runtime/models (no un
# directorio real) -- "models/" con barra no matchea un symlink en git, hay
# que ignorarlo explícito o vuelve a aparecer como untracked en git status.
motor/models
motor/logs
motor/config

# --- Estado interno de Vector (checkpoints, buffers) ---
**/.vector-data/

# --- Outputs del pipeline ---
outputs/
*.jsonl
*.jsonl.gz
*.out
*.log

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*~

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/
dist/
.coverage
.coverage.*
htmlcov/
build/
*.egg-info/

# --- Datos crudos (datasets pesados — NO versionar) ---
*.csv
*.parquet
*.pcap
data/raw/

# --- OS ---
.DS_Store
Thumbs.db

# --- Claude Code: contenido de terceros, no versionar ---
.claude/skills/
